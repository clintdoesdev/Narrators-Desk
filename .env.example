# ElevenLabs API key (Profile -> API Keys). Server-only.
ELEVENLABS_API_KEY=
# Your custom voice ID (Voices -> your voice -> "ID"). Server-only.
VOICE_ID=
# The password you type on the login screen.
APP_PASSWORD=
# Random string, 32+ chars. Signs the session cookie. e.g. `openssl rand -base64 48`
SESSION_SECRET=
